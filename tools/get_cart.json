{
  "name": "get_cart",
  "description": "Retrieves the current shopping cart contents and summary for the authenticated user on Carrefour France. Returns cart totals (amounts, discounts, loyalty points, delivery fees), marketplace sub-baskets, additional orders, preorders, and relevant API endpoints. Optionally forces a refresh of cart data.",
  "parameters": {
    "type": "object",
    "properties": {
      "refresh": {
        "type": "boolean",
        "description": "If true, forces a server-side refresh of the cart data before returning it."
      }
    },
    "required": []
  },
  "request": {
    "method": "GET",
    "url": "https://www.carrefour.fr/api/cart",
    "headers": {
      "x-requested-with": "XMLHttpRequest",
      "accept": "application/json, text/plain, */*"
    },
    "query": {
      "refresh": {
        "$param": "refresh"
      }
    },
    "body": null,
    "content_type": "application/json"
  },
  "requires_auth": true,
